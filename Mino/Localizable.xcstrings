          }
        }
      }
    },
    "This PDF opens without a password but limits printing or copying. Enter its permissions password to save a copy without the limits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses PDF lässt sich ohne Passwort öffnen, schränkt aber Drucken oder Kopieren ein. Gib sein Berechtigungspasswort ein, um eine Kopie ohne Einschränkungen zu sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PDF se abre sin contraseña, pero limita la impresión o la copia. Introduce su contraseña de permisos para guardar una copia sin límites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce PDF s’ouvre sans mot de passe mais limite l’impression ou la copie. Saisissez son mot de passe des autorisations pour enregistrer une copie sans ces limites."
          }
        }
      }
    },
    "This file couldn't be opened: %@" : {
