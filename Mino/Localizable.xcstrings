          }
        }
      }
    },
    "Tap where you want to sign. This is a drawn signature, not a certified digital signature. It is kept on this %@ only and fixed in place when you save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe dorthin, wo du unterschreiben möchtest. Dies ist eine gezeichnete Unterschrift, keine zertifizierte digitale Signatur. Sie wird nur auf diesem %@ gespeichert und beim Sichern fest eingefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca donde quieras firmar. Es una firma dibujada, no una firma digital certificada. Solo se guarda en este %@ y queda fijada en la página al guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l’endroit où vous voulez signer. Il s’agit d’une signature dessinée, et non d’une signature numérique certifiée. Elle est conservée uniquement sur cet %@ et figée dans le document à l’enregistrement."
          }
        }
      }
    },
