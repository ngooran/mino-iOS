    "White-out covers what is underneath. The covered text stays in the file, so don't use it to hide confidential information." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Abdecken“ verdeckt, was darunter liegt. Der verdeckte Text bleibt in der Datei, verwende es also nicht, um vertrauliche Informationen zu verbergen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El corrector tapa lo que hay debajo. El texto tapado sigue en el archivo, así que no lo uses para ocultar información confidencial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le correcteur recouvre ce qui se trouve dessous. Le texte recouvert reste dans le fichier : ne l’utilisez pas pour masquer des informations confidentielles."
          }
        }
      }
    },
